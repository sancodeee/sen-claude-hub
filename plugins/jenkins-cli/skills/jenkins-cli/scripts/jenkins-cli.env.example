# Copy to ~/.local/share/jenkins/.jenkins-cli.env only if it does not exist.
# Keep this trusted shell configuration private: chmod 600 <config-file>.
# Fill the token locally; never commit the completed file or echo its contents.
JENKINS_URL='https://jenkins.example.com/'
JENKINS_USER_ID=''
JENKINS_API_TOKEN=''
JENKINS_CLI_MODE='-webSocket'
